<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pastel Tamagotchi Pet</title>
  <style>
    :root {
      --bg-color: #fcf4dd;
      --card-bg: #ffffff;
      --accent-pink: #ffc6ff;
      --accent-blue: #9dcfe3;
      --accent-green: #9dcfe3;
      --accent-yellow: #fdffb6;
      --accent-purple: #bdb2ff;
      --text-color: #4a4e69;
      --border-color: #9bf6ff;
    }

    * {
      box-sizing: border-box;
      user-select: none;
    }

    body {
      margin: 0;
      padding: 10px;
      font-family: 'Courier New', Courier, monospace;
      background-color: transparent;
      display: flex;
      justify-content: center;
      align-items: center;
      color: var(--text-color);
    }

    .widget-container {
      width: 100%;
      max-width: 360px;
      background: #fff5f8;
      border: 4px solid #f7bee1;
      border-radius: 24px;
      padding: 15px;
      position: relative;
      box-shadow: 0 8px 16px rgba(0,0,0,0.05);
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* Top Bar Buttons */
    .top-bar {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
    }

    .icon-btn {
      background: #ffffff;
      border: 2px solid #f7bee1;
      border-radius: 12px;
      padding: 6px 10px;
      font-size: 16px;
      cursor: pointer;
      box-shadow: 0 3px 0 #f7bee1;
      transition: all 0.1s ease;
    }

    .icon-btn:active {
      transform: translateY(3px);
      box-shadow: none;
    }

    /* Coins Display in Center */
    .coins-display {
      background: #ffffff;
      border: 2px solid #bdb2ff;
      border-radius: 16px;
      padding: 6px 14px;
      font-weight: bold;
      font-size: 14px;
      color: #5c5470;
      box-shadow: 0 3px 0 #bdb2ff;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* Main Screen Area */
    .screen {
      width: 100%;
      background: #ffffff;
      border: 3px solid #f7bee1;
      border-radius: 16px;
      padding: 15px;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 200px;
      justify-content: center;
      position: relative;
    }

    /* Pet & Bowl Display */
    .pet-stage {
      position: relative;
      width: 130px;
      height: 130px;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .pet-svg {
      width: 90px;
      height: 90px;
      image-rendering: pixelated;
      z-index: 2;
    }

    .hat-svg {
      position: absolute;
      top: -2px;
      left: 50%;
      transform: translateX(-50%);
      width: 50px;
      height: 50px;
      image-rendering: pixelated;
      z-index: 3;
    }

    .bowl-svg {
      position: absolute;
      bottom: -4px;
      right: 0px;
      width: 48px;
      height: 38px;
      image-rendering: pixelated;
      z-index: 3;
    }

    /* Task Buttons */
    .tasks-container {
      width: 100%;
      display: flex;
      gap: 10px;
      margin-top: 15px;
    }

    .task-btn {
      flex: 1;
      background: #9dcfe3;
      border: 2px solid #6cb4d1;
      color: #000000;
      padding: 8px 4px;
      border-radius: 12px;
      font-family: inherit;
      font-size: 11px;
      font-weight: bold;
      cursor: pointer;
      box-shadow: 0 3px 0 #6cb4d1;
      transition: all 0.1s ease;
      text-align: center;
    }

    .task-btn:active {
      transform: translateY(3px);
      box-shadow: none;
    }

    .task-btn.haushalt {
      background: #9dcfe3;
      border-color: #6cb4d1;
      box-shadow: 0 3px 0 #6cb4d1;
      color: #000000;
    }

    /* Test Switch Button Bottom Left */
    .bottom-bar {
      width: 100%;
      display: flex;
      justify-content: flex-start;
      margin-top: 10px;
    }

    .switch-btn {
      background: #f0efeb;
      border: 1px solid #ccc;
      border-radius: 8px;
      padding: 4px 8px;
      font-size: 11px;
      cursor: pointer;
      color: #666;
    }

    /* Selection Screen & Modals */
    .modal {
      display: none;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(255, 245, 248, 0.98);
      border-radius: 20px;
      z-index: 10;
      padding: 15px;
      flex-direction: column;
      align-items: center;
      overflow-y: auto;
    }

    .modal.active {
      display: flex;
    }

    .modal-title {
      font-size: 13px;
      font-weight: bold;
      margin-bottom: 12px;
      text-align: center;
    }

    .pet-select-btn {
      width: 100%;
      background: #ffffff;
      border: 2px solid #f7bee1;
      padding: 8px;
      border-radius: 12px;
      margin-bottom: 8px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-family: inherit;
      font-size: 12px;
      box-shadow: 0 3px 0 #f7bee1;
    }

    .pet-select-btn:active {
      transform: translateY(3px);
      box-shadow: none;
    }

    .shop-grid, .inventory-grid {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .item-card {
      background: #ffffff;
      border: 2px solid #e0e0e0;
      border-radius: 10px;
      padding: 6px 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12px;
    }

    .buy-btn, .equip-btn {
      background: #9dcfe3;
      border: 1px solid #6cb4d1;
      color: #000;
      padding: 4px 8px;
      border-radius: 6px;
      cursor: pointer;
      font-family: inherit;
      font-size: 11px;
      font-weight: bold;
    }

    .buy-btn:disabled, .equip-btn:disabled {
      background: #e0e0e0;
      border-color: #cccccc;
      color: #777;
      cursor: default;
    }

    .close-btn {
      margin-top: auto;
      background: #f7bee1;
      border: none;
      padding: 6px 12px;
      border-radius: 8px;
      cursor: pointer;
      font-family: inherit;
      font-weight: bold;
      font-size: 11px;
      color: #000;
    }
  </style>
</head>
<body>

  <div class="widget-container">
    
    <div class="top-bar">
      <button class="icon-btn" onclick="openModal('inventory-modal')" title="Rucksack">🎒</button>
      <div class="coins-display">
        🪙 <span id="coin-count">0</span>
      </div>
      <button class="icon-btn" onclick="openModal('shop-modal')" title="Shop">🛒</button>
    </div>

    <div class="screen">
      
      <div id="selection-screen" style="display:none; width:100%; text-align:center;">
        <div class="modal-title">Suche dein Haustier raus:</div>
        <button class="pet-select-btn" onclick="selectPet('cat')">
          <span>🐱 Weiße Katze</span> <b>Mochi</b>
        </button>
        <button class="pet-select-btn" onclick="selectPet('dog')">
          <span>🐶 Brauner Hund</span> <b>Biscoff</b>
        </button>
        <button class="pet-select-btn" onclick="selectPet('rabbit')">
          <span>🐰 Beiges Kaninchen</span> <b>Clover</b>
        </button>
      </div>

      <div id="pet-view" style="display:flex; flex-direction:column; align-items:center;">
        <div class="pet-stage">
          <div id="hat-layer"></div>
          <div id="pet-layer"></div>
          <div id="bowl-layer"></div>
        </div>
        <div id="pet-name-display" style="font-size: 12px; font-weight: bold; margin-top: 5px;"></div>
      </div>

    </div>

    <div class="tasks-container">
      <button class="task-btn" onclick="addCoins(2)">To-Do (+2 🪙)</button>
      <button class="task-btn haushalt" onclick="addCoins(5)">Haushalt (+5 🪙)</button>
    </div>

    <div class="bottom-bar">
      <button class="switch-btn" onclick="openSelectionScreen()" title="Tier wechseln (Testen)">🔄 Tier wechseln</button>
    </div>

    <div class="modal" id="shop-modal">
      <div class="modal-title">🛒 Tamagotchi Shop</div>
      <div class="shop-grid">
        <div style="font-weight:bold; font-size:11px; margin-top:4px;">Hüte (15 🪙):</div>
        <div id="shop-hats"></div>
        <div style="font-weight:bold; font-size:11px; margin-top:8px;">Näpfe (10 🪙):</div>
        <div id="shop-bowls"></div>
      </div>
      <button class="close-btn" onclick="closeModal('shop-modal')">Schließen</button>
    </div>

    <div class="modal" id="inventory-modal">
      <div class="modal-title">🎒 Dein Rucksack</div>
      <div class="inventory-grid">
        <div style="font-weight:bold; font-size:11px; margin-top:4px;">Ausrüstung:</div>
        <div id="inventory-items"></div>
      </div>
      <button class="close-btn" onclick="closeModal('inventory-modal')">Schließen</button>
    </div>

  </div>

  <script>
    // Asset SVGs (Pixel Art)
    const PET_SVGS = {
      cat: `<svg class="pet-svg" viewBox="0 0 24 24" fill="none"><rect x="7" y="5" width="2" height="1" fill="#1a1a1a"/><rect x="15" y="5" width="2" height="1" fill="#1a1a1a"/><rect x="7" y="6" width="1" height="3" fill="#1a1a1a"/><rect x="8" y="6" width="1" height="2" fill="#fca5a5"/><rect x="16" y="6" width="1" height="3" fill="#1a1a1a"/><rect x="15" y="6" width="1" height="2" fill="#fca5a5"/><rect x="9" y="6" width="6" height="1" fill="#1a1a1a"/><rect x="6" y="9" width="1" height="11" fill="#1a1a1a"/><rect x="17" y="9" width="1" height="11" fill="#1a1a1a"/><rect x="7" y="20" width="10" height="1" fill="#1a1a1a"/><rect x="7" y="9" width="10" height="11" fill="#ffffff"/><rect x="8" y="7" width="8" height="2" fill="#ffffff"/><rect x="9" y="10" width="1" height="3" fill="#1a1a1a"/><rect x="14" y="10" width="1" height="3" fill="#1a1a1a"/><rect x="11" y="12" width="2" height="1" fill="#f472b6"/><rect x="8" y="12" width="1" height="1" fill="#fbcfe8"/><rect x="15" y="12" width="1" height="1" fill="#fbcfe8"/><rect x="9" y="18" width="1" height="2" fill="#d1d5db"/><rect x="11" y="18" width="2" height="2" fill="#d1d5db"/><rect x="14" y="18" width="1" height="2" fill="#d1d5db"/></svg>`,
      dog: `<svg class="pet-svg" viewBox="0 0 24 24" fill="none"><rect x="5" y="7" width="3" height="5" fill="#8c5a3c"/><rect x="16" y="7" width="3" height="5" fill="#8c5a3c"/><rect x="8" y="6" width="8" height="13" fill="#d4a373"/><rect x="7" y="8" width="10" height="11" fill="#d4a373"/><rect x="7" y="7" width="10" height="1" fill="#8c5a3c"/><rect x="9" y="10" width="1" height="2" fill="#1a1a1a"/><rect x="14" y="10" width="1" height="2" fill="#1a1a1a"/><rect x="11" y="12" width="2" height="2" fill="#1a1a1a"/><rect x="8" y="12" width="1" height="1" fill="#ffb5a7"/><rect x="15" y="12" width="1" height="1" fill="#ffb5a7"/><rect x="9" y="17" width="2" height="3" fill="#8c5a3c"/><rect x="13" y="17" width="2" height="3" fill="#8c5a3c"/></svg>`,
      rabbit: `<svg class="pet-svg" viewBox="0 0 24 24" fill="none"><rect x="8" y="2" width="2" height="7" fill="#e9d8a6"/><rect x="9" y="3" width="1" height="5" fill="#ffccd5"/><rect x="14" y="2" width="2" height="7" fill="#e9d8a6"/><rect x="14" y="3" width="1" height="5" fill="#ffccd5"/><rect x="7" y="8" width="10" height="11" fill="#e9d8a6"/><rect x="6" y="10" width="12" height="8" fill="#e9d8a6"/><rect x="9" y="11" width="1" height="2" fill="#1a1a1a"/><rect x="14" y="11" width="1" height="2" fill="#1a1a1a"/><rect x="11" y="13" width="2" height="1" fill="#ff85a1"/><rect x="8" y="13" width="1" height="1" fill="#ffccd5"/><rect x="15" y="13" width="1" height="1" fill="#ffccd5"/><rect x="9" y="18" width="2" height="2" fill="#ffffff"/><rect x="13" y="18" width="2" height="2" fill="#ffffff"/></svg>`
    };

    // Leckerbissen (Fisch für Katze, Knochen für Hund, Möhre für Kaninchen)
    const TREAT_SVGS = {
      cat: `<path d="M12 4 L18 8 L12 12 L14 8 Z" fill="#9dcfe3" stroke="#2b1e1a" stroke-width="0.8"/><circle cx="10" cy="8" r="4" fill="#6cb4d1" stroke="#2b1e1a" stroke-width="0.8"/><circle cx="8" cy="7" r="0.8" fill="#ffffff"/>`,
      dog: `<rect x="6" y="6" width="12" height="4" fill="#fff3b0" stroke="#d4a373" stroke-width="0.8"/><circle cx="6" cy="5" r="2.2" fill="#fff3b0" stroke="#d4a373" stroke-width="0.8"/><circle cx="6" cy="11" r="2.2" fill="#fff3b0" stroke="#d4a373" stroke-width="0.8"/><circle cx="18" cy="5" r="2.2" fill="#fff3b0" stroke="#d4a373" stroke-width="0.8"/><circle cx="18" cy="11" r="2.2" fill="#fff3b0" stroke="#d4a373" stroke-width="0.8"/>`,
      rabbit: `<path d="M7 12 L13 2 L17 6 Z" fill="#f77f00" stroke="#2b1e1a" stroke-width="0.8"/><path d="M14 3 L18 0 M15 4 L20 2" stroke="#52b788" stroke-width="1.5" stroke-linecap="round"/>`
    };

    // Farben für die Näpfe
    const BOWL_COLORS = {
      rot: { main: '#ffa6a6', rim: '#ff5252', base: '#ff2a2a' },
      gruen: { main: '#caffbf', rim: '#9bf6ff', base: '#70e000' },
      blau: { main: '#9dcfe3', rim: '#6cb4d1', base: '#4895ef' },
      rosa: { main: '#f7bee1', rim: '#ffc6ff', base: '#ff85a1' },
      gelb: { main: '#fdffb6', rim: '#caefd7', base: '#ffd166' },
      lila: { main: '#bdb2ff', rim: '#e7c6ff', base: '#9d4edd' }
    };

    function renderBowlSVG(colorKey, petType) {
      const colors = BOWL_COLORS[colorKey] || BOWL_COLORS['rot'];
      const treat = TREAT_SVGS[petType] || TREAT_SVGS['dog'];

      return `<svg class="bowl-svg" viewBox="0 0 24 20">
        <g transform="translate(0, 0)">
          ${treat}
        </g>
        <path d="M2 17 Q 12 19 22 17 L 24 19 Q 12 21 0 19 Z" fill="${colors.base}"/>
        <path d="M3 11 L 21 11 L 22 17 L 2 17 Z" fill="${colors.main}" stroke="#2b1e1a" stroke-width="0.8"/>
        <ellipse cx="12" cy="11" rx="10" ry="2.5" fill="${colors.rim}" stroke="#2b1e1a" stroke-width="0.8"/>
        <circle cx="12" cy="14.5" r="1" fill="#ffffff"/>
        <circle cx="10.8" cy="13.3" r="0.5" fill="#ffffff"/>
        <circle cx="13.2" cy="13.3" r="0.5" fill="#ffffff"/>
        <circle cx="12" cy="12.8" r="0.5" fill="#ffffff"/>
      </svg>`;
    }

    // Detaillierte Pixel-Früchte im Animal Crossing Style
    const HAT_SVGS = {
      erdbeere: `<svg class="hat-svg" viewBox="0 0 16 16"><rect x="6" y="2" width="4" height="10" fill="#2b1e1a"/><rect x="7" y="1" width="2" height="11" fill="#2b1e1a"/><rect x="4" y="4" width="8" height="9" fill="#2b1e1a"/><rect x="5" y="3" width="6" height="10" fill="#2b1e1a"/><rect x="5" y="5" width="6" height="7" fill="#e63946"/><rect x="6" y="4" width="4" height="8" fill="#e63946"/><rect x="5" y="5" width="2" height="3" fill="#ff758f"/><rect x="8" y="7" width="1" height="2" fill="#ffccd5"/><rect x="6" y="9" width="1" height="2" fill="#ffccd5"/><rect x="7" y="1" width="2" height="2" fill="#2b1e1a"/><rect x="6" y="2" width="4" height="1" fill="#52b788"/><rect x="5" y="3" width="6" height="1" fill="#52b788"/><rect x="6" y="4" width="4" height="1" fill="#2b1e1a"/></svg>`,
      kiwi: `<svg class="hat-svg" viewBox="0 0 16 16"><rect x="4" y="4" width="8" height="8" fill="#2b1e1a"/><rect x="5" y="3" width="6" height="10" fill="#2b1e1a"/><rect x="3" y="5" width="10" height="6" fill="#2b1e1a"/><rect x="5" y="4" width="6" height="8" fill="#90be6d"/><rect x="4" y="5" width="8" height="6" fill="#90be6d"/><rect x="6" y="5" width="4" height="6" fill="#f9f7f1"/><rect x="7" y="6" width="2" height="4" fill="#f9f7f1"/><rect x="5" y="6" width="1" height="1" fill="#2b1e1a"/><rect x="10" y="6" width="1" height="1" fill="#2b1e1a"/><rect x="5" y="9" width="1" height="1" fill="#2b1e1a"/><rect x="10" y="9" width="1" height="1" fill="#2b1e1a"/></svg>`,
      apfel_rot: `<svg class="hat-svg" viewBox="0 0 16 16"><rect x="7" y="1" width="2" height="3" fill="#2b1e1a"/><rect x="8" y="1" width="2" height="1" fill="#52b788"/><rect x="4" y="4" width="8" height="8" fill="#2b1e1a"/><rect x="5" y="3" width="6" height="10" fill="#2b1e1a"/><rect x="3" y="5" width="10" height="6" fill="#2b1e1a"/><rect x="5" y="4" width="6" height="8" fill="#ff4d6d"/><rect x="4" y="5" width="8" height="6" fill="#ff4d6d"/><rect x="5" y="4" width="3" height="3" fill="#ffccd5"/><rect x="7" y="11" width="2" height="1" fill="#ff758f"/></svg>`,
      kirsche: `<svg class="hat-svg" viewBox="0 0 16 16"><rect x="6" y="1" width="4" height="6" fill="#2b1e1a"/><rect x="7" y="1" width="2" height="5" fill="#52b788"/><rect x="2" y="7" width="5" height="5" fill="#2b1e1a"/><rect x="9" y="7" width="5" height="5" fill="#2b1e1a"/><rect x="3" y="8" width="3" height="3" fill="#ff0054"/><rect x="10" y="8" width="3" height="3" fill="#ff0054"/><rect x="3" y="8" width="1" height="1" fill="#ffb5a7"/><rect x="10" y="8" width="1" height="1" fill="#ffb5a7"/></svg>`,
      pfirsich: `<svg class="hat-svg" viewBox="0 0 16 16"><rect x="4" y="4" width="8" height="8" fill="#2b1e1a"/><rect x="5" y="3" width="6" height="10" fill="#2b1e1a"/><rect x="3" y="5" width="10" height="6" fill="#2b1e1a"/><rect x="5" y="4" width="6" height="8" fill="#ffb5a7"/><rect x="4" y="5" width="8" height="6" fill="#ffb5a7"/><rect x="5" y="4" width="3" height="3" fill="#ffffff"/><rect x="8" y="6" width="1" height="5" fill="#f784ad"/><rect x="5" y="11" width="6" height="1" fill="#52b788"/></svg>`,
      orange: `<svg class="hat-svg" viewBox="0 0 16 16"><rect x="7" y="1" width="2" height="2" fill="#52b788"/><rect x="4" y="4" width="8" height="8" fill="#2b1e1a"/><rect x="5" y="3" width="6" height="10" fill="#2b1e1a"/><rect x="3" y="5" width="10" height="6" fill="#2b1e1a"/><rect x="5" y="4" width="6" height="8" fill="#f77f00"/><rect x="4" y="5" width="8" height="6" fill="#f77f00"/><rect x="5" y="4" width="3" height="3" fill="#fcbf49"/><rect x="9" y="5" width="1" height="1" fill="#ffffff"/><rect x="6" y="9" width="1" height="1" fill="#d45700"/></svg>`,
      apfel_gruen: `<svg class="hat-svg" viewBox="0 0 16 16"><rect x="7" y="1" width="2" height="3" fill="#2b1e1a"/><rect x="8" y="1" width="2" height="1" fill="#38b000"/><rect x="4" y="4" width="8" height="8" fill="#2b1e1a"/><rect x="5" y="3" width="6" height="10" fill="#2b1e1a"/><rect x="3" y="5" width="10" height="6" fill="#2b1e1a"/><rect x="5" y="4" width="6" height="8" fill="#70e000"/><rect x="4" y="5" width="8" height="6" fill="#70e000"/><rect x="5" y="4" width="3" height="3" fill="#ccff33"/><rect x="7" y="11" width="2" height="1" fill="#38b000"/></svg>`
    };

    const PET_NAMES = { cat: "Mochi (Katze)", dog: "Biscoff (Hund)", rabbit: "Clover (Kaninchen)" };

    const HATS_DATA = [
      { id: 'erdbeere', name: '🍓 Erdbeere', price: 15 },
      { id: 'kiwi', name: '🥝 Kiwi', price: 15 },
      { id: 'apfel_rot', name: '🍎 Roter Apfel', price: 15 },
      { id: 'kirsche', name: '🍒 Kirsche', price: 15 },
      { id: 'pfirsich', name: '🍑 Pfirsich', price: 15 },
      { id: 'orange', name: '🍊 Orange', price: 15 },
      { id: 'apfel_gruen', name: '🍏 Grüner Apfel', price: 15 }
    ];

    const BOWLS_DATA = [
      { id: 'gruen', name: '🥣 Pastel Grün', price: 10 },
      { id: 'blau', name: '🥣 Pastel Blau', price: 10 },
      { id: 'rosa', name: '🥣 Pastel Rosa', price: 10 },
      { id: 'gelb', name: '🥣 Pastel Gelb', price: 10 },
      { id: 'lila', name: '🥣 Pastel Lila', price: 10 }
    ];

    // State Variables
    let coins = parseInt(localStorage.getItem('tama_coins')) || 0;
    let currentPet = localStorage.getItem('tama_pet') || null;
    let currentHat = localStorage.getItem('tama_hat') || null;
    let currentBowl = localStorage.getItem('tama_bowl') || 'rot';
    let inventory = JSON.parse(localStorage.getItem('tama_inventory')) || ['rot'];

    function saveState() {
      localStorage.setItem('tama_coins', coins);
      localStorage.setItem('tama_pet', currentPet || '');
      localStorage.setItem('tama_hat', currentHat || '');
      localStorage.setItem('tama_bowl', currentBowl);
      localStorage.setItem('tama_inventory', JSON.stringify(inventory));
    }

    function updateUI() {
      document.getElementById('coin-count').innerText = coins;

      if (!currentPet) {
        document.getElementById('selection-screen').style.display = 'block';
        document.getElementById('pet-view').style.display = 'none';
      } else {
        document.getElementById('selection-screen').style.display = 'none';
        document.getElementById('pet-view').style.display = 'flex';

        document.getElementById('pet-layer').innerHTML = PET_SVGS[currentPet] || '';
        document.getElementById('hat-layer').innerHTML = currentHat ? HAT_SVGS[currentHat] : '';
        document.getElementById('bowl-layer').innerHTML = renderBowlSVG(currentBowl, currentPet);
        document.getElementById('pet-name-display').innerText = PET_NAMES[currentPet];
      }

      renderShop();
      renderInventory();
    }

    function addCoins(amount) {
      coins += amount;
      saveState();
      updateUI();
    }

    function selectPet(type) {
      currentPet = type;
      saveState();
      updateUI();
    }

    function openSelectionScreen() {
      document.getElementById('selection-screen').style.display = 'block';
      document.getElementById('pet-view').style.display = 'none';
    }

    function openModal(id) {
      document.getElementById(id).classList.add('active');
    }

    function closeModal(id) {
      document.getElementById(id).classList.remove('active');
    }

    function buyItem(id, price) {
      if (coins >= price && !inventory.includes(id)) {
        coins -= price;
        inventory.push(id);
        saveState();
        updateUI();
      }
    }

    function equipItem(type, id) {
      if (type === 'hat') {
        currentHat = (currentHat === id) ? null : id;
      } else if (type === 'bowl') {
        currentBowl = id;
      }
      saveState();
      updateUI();
    }

    function renderShop() {
      const hatsContainer = document.getElementById('shop-hats');
      hatsContainer.innerHTML = '';
      HATS_DATA.forEach(item => {
        const owned = inventory.includes(item.id);
        hatsContainer.innerHTML += `
          <div class="item-card">
            <span>${item.name}</span>
            <button class="buy-btn" onclick="buyItem('${item.id}', ${item.price})" ${owned || coins < item.price ? 'disabled' : ''}>
              ${owned ? 'Gekauft' : item.price + ' 🪙'}
            </button>
          </div>`;
      });

      const bowlsContainer = document.getElementById('shop-bowls');
      bowlsContainer.innerHTML = '';
      BOWLS_DATA.forEach(item => {
        const owned = inventory.includes(item.id);
        bowlsContainer.innerHTML += `
          <div class="item-card">
            <span>${item.name}</span>
            <button class="buy-btn" onclick="buyItem('${item.id}', ${item.price})" ${owned || coins < item.price ? 'disabled' : ''}>
              ${owned ? 'Gekauft' : item.price + ' 🪙'}
            </button>
          </div>`;
      });
    }

    function renderInventory() {
      const container = document.getElementById('inventory-items');
      container.innerHTML = '';

      container.innerHTML += `
        <div class="item-card">
          <span>🥣 Standard Napf (Rot)</span>
          <button class="equip-btn" onclick="equipItem('bowl', 'rot')">
            ${currentBowl === 'rot' ? 'Aktiv' : 'Anziehen'}
          </button>
        </div>`;

      inventory.forEach(itemId => {
        const hat = HATS_DATA.find(h => h.id === itemId);
        if (hat) {
          const isEquipped = currentHat === hat.id;
          container.innerHTML += `
            <div class="item-card">
              <span>${hat.name}</span>
              <button class="equip-btn" onclick="equipItem('hat', '${hat.id}')">
                ${isEquipped ? 'Ablegen' : 'Anziehen'}
              </button>
            </div>`;
        }

        const bowl = BOWLS_DATA.find(b => b.id === itemId);
        if (bowl) {
          const isEquipped = currentBowl === bowl.id;
          container.innerHTML += `
            <div class="item-card">
              <span>${bowl.name}</span>
              <button class="equip-btn" onclick="equipItem('bowl', '${bowl.id}')">
                ${isEquipped ? 'Aktiv' : 'Anziehen'}
              </button>
            </div>`;
        }
      });
    }

    updateUI();
  </script>
</body>
</html>
